{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "timslip-work",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": false,
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"vars": {
		"TURSO_DATABASE_URL": "libsql://timslip-db-johnfire.aws-ap-northeast-1.turso.io"
	},
	"d1_databases": [
		{
			"binding": "USER_DB",
			"database_name": "timeslip-shiji-users",
			"database_id": "5b627cc1-5f18-4eaf-aba8-f7ebe214404f",
			"migrations_dir": "src/worker/migrations",
			"remote": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "745595ac1e154fe7a44f2d7cfa1f7168",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "AVATAR_BUCKET",
			"bucket_name": "timslip-avatars",
			"preview_bucket_name": "timslip-avatars",
			"remote": true
		},
		{
			"binding": "ASSETS_BUCKET",
			"bucket_name": "timslip-assets",
			"preview_bucket_name": "timslip-assets",
			"remote": true
		}
	],
	"images": {
		"binding": "IMAGES"
	}
}
